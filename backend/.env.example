# AI-Analyzer-Plan v2.1 — Environment Configuration
# ===================================================
# LLM endpoint (OpenAI-compatible)
# For cloud: Alibaba GLM (KZ-accessible, free tier)
# For local: Ollama or LM Studio

# Cloud (Alibaba GLM) — WORKS FROM KZ, no Ollama needed
OLLAMA_BASE_URL=https://ws-yreibc51vw8gp9za.ap-southeast-1.maas.aliyuncs.com/compatible-mode
OLLAMA_API_KEY=your-alibaba-key-here
OLLAMA_DEFAULT_MODEL=glm-5.2-fast-preview
OLLAMA_TIMEOUT=30

# Local Ollama (alternative — if installed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=
# OLLAMA_DEFAULT_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT=120

# Local LM Studio (alternative)
# OLLAMA_BASE_URL=http://localhost:1234
# OLLAMA_API_KEY=
# OLLAMA_DEFAULT_MODEL=qwen_qwen2.5-vl-7b-instruct
# OLLAMA_TIMEOUT=120

# ML Filter Phase: log_only (1A) or active (1B)
ML_FILTER_PHASE=log_only

# GPU Detection
GPU_DETECTION=auto
MANUAL_VRAM_GB=4
